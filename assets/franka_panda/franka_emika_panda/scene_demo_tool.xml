<mujoco model="polishing_demo_tool">
  <!-- Large-sphere polishing demo with cylindrical tool + wrist FT sensor.
       Robot: panda_4.xml (FT sensor, tool_center_site, wrist_force/wrist_torque).
       Sphere: R=0.3 m, centre=(0.5, 0, 0.3), top z=0.6 m.
       Use SimEnvTool (tool_center_site + ft_site) and config.*_DEMO_TOOL params. -->
  <include file="panda_4.xml"/>

  <statistic center="0.35 0 0.35" extent="1.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="sphere_mat" rgba="0.5 0.75 0.95 0.85" specular="0.7" shininess="0.5"/>
    <material name="pedestal_mat" rgba="0.35 0.35 0.4 1" specular="0.3" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <light pos="1 -1 1.5" dir="-0.5 0.5 -1" directional="true" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Pedestal: covers the lower hemisphere visually (R=0.3 sphere, centre z=0.3) -->
    <body name="pedestal" pos="0.5 0 0.15">
      <geom type="cylinder" size="0.28 0.15" material="pedestal_mat"
            contype="0" conaffinity="0"/>
    </body>

    <!-- 3/8 sphere polishing surface: centre=(0.5,0,0.3), R=0.3 m, top z=0.6 m -->
    <!-- contype=3 / conaffinity=3 (bits 0+1):
           bit 0 — collides with robot links (panda/collision default contype=1)
           bit 1 — collides with tool_collision cylinder (contype=2, affinity=2) -->
    <body name="sphere_body" pos="0.5 0 0.3">
      <geom name="polishing_sphere" type="sphere" size="0.3"
            material="sphere_mat"
            contype="3" conaffinity="3"
            solref="0.300 1.5" solimp="0.9 0.99 0.001"
            margin="0.001"
            condim="3"
            friction="0.8 0.02 0.001"/>
    </body>
  </worldbody>

</mujoco>
